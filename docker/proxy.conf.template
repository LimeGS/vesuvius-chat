limit_req_zone $binary_remote_addr zone=requests:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=connections:1m;
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /tls/tls.crt;
    ssl_certificate_key /tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null;
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 10s;
    limit_req zone=requests burst=30 nodelay;
    limit_conn connections 20;
    limit_req_status 429;
    limit_conn_status 429;
    if ($http_host != ${APP_HOST}) { return 421; }
    location / {
        proxy_pass http://app:3000;
        proxy_set_header Host ${APP_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Request-ID "";
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 190s;
    }
}
